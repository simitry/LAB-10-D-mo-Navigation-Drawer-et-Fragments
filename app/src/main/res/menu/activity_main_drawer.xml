<?xml version="1.0" encoding="utf-8"?>
<!-- This file defines the items shown inside the navigation drawer menu. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This group keeps the menu items together and allows one item to be selected at a time. -->
    <group android:checkableBehavior="single">

        <!-- This item opens Fragment 1 when the user taps "Fragment 1" in the drawer. -->
        <item
            android:id="@+id/nav_fragment1"
            android:icon="@drawable/ic_home"
            android:title="Fragment 1" />

        <!-- This item opens Fragment 2 when the user taps "Fragment 2" in the drawer. -->
        <item
            android:id="@+id/nav_fragment2"
            android:icon="@drawable/ic_dashboard"
            android:title="Fragment 2" />

        <!-- This item opens the ListFragment when the user taps "Fragment List" in the drawer. -->
        <item
            android:id="@+id/nav_list"
            android:icon="@drawable/ic_list"
            android:title="Fragment List" />

    </group>
</menu>
